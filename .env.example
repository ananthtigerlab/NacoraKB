# Copy this file to .env and fill in.
# .env is git-ignored.

# --- LLM provider ---
# Pick one: "anthropic" (default) or "gemini". You only need the key for the provider you choose.
LLM_PROVIDER=anthropic

# --- Anthropic (Claude) ---
# Get a key at https://console.anthropic.com/settings/keys — requires a paid plan.
ANTHROPIC_API_KEY=sk-ant-api03-...
# Optional model override. Defaults to claude-sonnet-4-6.
# ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Google Gemini ---
# Get a key at https://aistudio.google.com/apikey — free tier available.
# GEMINI_API_KEY=AIza...
# Optional model override. Defaults to gemini-2.5-flash. Use gemini-2.5-pro for the discovery pass
# if you want higher-quality synthesis (slower + fewer free requests/min).
GEMINI_MODEL=gemini-2.5-flash

# --- Phase 2 — local code grounding ---
# Absolute path to the checked-out InSurance repo (read-only).
NACORA_CODE_PATH=/Users/tigerlab/Downloads/GitHubProjects/InSurance

# --- Phase 3 — optional connectors ---
# ATLASSIAN_EMAIL=
# ATLASSIAN_API_TOKEN=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# FIGMA_PERSONAL_ACCESS_TOKEN=
